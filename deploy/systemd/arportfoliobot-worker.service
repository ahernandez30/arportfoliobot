[Unit]
Description=AR Portfolio Bot background worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=arpb
Group=arpb
WorkingDirectory=/opt/arportfoliobot/backend
EnvironmentFile=/etc/arportfoliobot/arportfoliobot.env
ExecStart=/opt/arportfoliobot/backend/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
